{% set parallax = [
  {
    bg: 'https://i.ibb.co/JpJVJxq/Background.png',
    img: 'https://i.ibb.co/Dw3q3tZ/cutout.png'
  },
  {
    bg: 'https://i.ibb.co/ZdGBm4K/m-background.png',
    img: 'https://i.ibb.co/RC70XmC/m-cutout.png'
  },
  {
    bg: 'https://i.ibb.co/MDBcyMW/b-background.png',
    img: 'https://i.ibb.co/bQNgD6y/b-cutout.png'
  }
] %}

<section class="wrapper flex flex-col items-center justify-center bg-white dark:bg-black overflow-hidden" data-parallax>
  {{ subtitle.render(text = 'Parallax hovered', className = 'mb-8 transition-[opacity,translate] duration-500 not-data-[anim=show]:opacity-0 not-data-[anim=show]:translate-y-10', data = 'data-anim data-movement="blend"') }}
  <div class="flex flex-col lg:flex-row items-center lg:justify-between gap-5 sm:gap-10">
    {% for item in parallax %}
    <div class="w-72" data-parallax-hovered="600">
      <div class="aspect-2/3 relative bg-grey dark:bg-dark overflow-hidden transition-transform ease-linear" data-parallax-item="10" data-media>
        {{ loader.render() }}
        {{ image.render(src = '#', className = 'media', data = 'data-lazy data-src="' ~ item.bg ~ '"') }}
        <div class="absolute inset-5 border-8 border-solid border-second transition-transform ease-linear" data-parallax-item="100">
          {{ image.render(src = '#', className = 'media transition-transform ease-linear', data = 'data-parallax-item="80" data-lazy data-src="' ~ item.img ~ '"') }}
          <div class="absolute top-auto bottom-0 left-0 right-0 text-white transition-transform ease-linear pointer-events-none p-10" data-parallax-item="160">
            <h2 class="font-medium text-xl/tight mb-3">
              Hover me!
            </h2>
            <p>
              Lorem, ipsum dolor sit amet consectetur adipisicing elit
            </p>
          </div>
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
</section>

