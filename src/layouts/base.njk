{% import 'src/components/icon.njk' as icon %}
{% import 'src/components/image.njk' as image %}
{% import 'src/components/preloader.njk' as preloader %}
{% import 'src/components/loader.njk' as loader %}

{% set social = ['ok', 'yt', 'inst', 'tw', 'fb', 'vk'] %}
{% set nav = {
  pages: [
    {
      href: 'index.html',
      text: 'Front-page'
    },
    {
      href: 'primary.html',
      text: 'Primary-page'
    },
    {
      href: 'second.html',
      text: 'Second-page'
    },
    {
      href: 'icons.html',
      text: 'Icons-page'
    }
  ],
  blocks: [
    {
      href: '#header',
      text: 'Header'
    },
    {
      href: '#player',
      text: 'Player'
    },
    {
      href: '#footer',
      text: 'Footer'
    }
  ]
} %}

<!doctype html>
<html data-domain="localhost" data-source="http://localhost:9000" lang="ru">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="author" content="//STDKIT">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="shortcut icon" href="/favicon/favicon.ico" type="image/x-icon">
  <title>
    {{ data.title }}
  </title>
  <script type="module" src="/src/application.ts"></script>
</head>

<body class="dark:bg-black dark:text-white">

  {# Прелоадер #}

  <div class="flex items-center justify-center fixed inset-0 z-50 bg-white dark:bg-black transition-[opacity,visibility]" data-preloader>
    {{ preloader.render() }}
  </div>

  {# Прогресс прокрутки страницы #}

  <div class="progress-bar hidden lg:block fixed inset-0 z-30 bg-primary h-1"></div>

  {# Заголовок #}

  <header class="wrapper flex items-center justify-between gap-5 sticky top-0 z-30 bg-black transition-transform duration-300 py-4" data-header>
    <a class="btn btn-white shrink-0 w-36" data-waved="light" draggable="false" href="/">
      {{ image.render(src = '/img/pictures/logo', format = 'png', className = 'w-full') }}
    </a>
    <nav class="lg:flex hidden items-center justify-between gap-4 w-full max-w-4xl ml-auto">
      {% for item in nav.pages %}
      <a class="btn btn-second font-normal uppercase text-sm underline-offset-4 hover:underline p-1" data-waved="light" draggable="false" href="{{ item.href }}">
        {{ item.text }}
      </a>
      {% endfor %}
      <div class="group/accordion relative" data-accordion data-auto data-close-scroll>
        <button class="btn btn-second font-normal uppercase text-sm underline-offset-4 hover:underline p-1" data-accordion-toggle data-waved="light">
          Navigation
          {{ icon.render(id = 'arrow-right', className = 'icon text-xs transition-transform ml-2 group-data-[accordion=active]/accordion:rotate-90') }}
        </button>
        <div class="absolute top-10 right-0 bg-white rounded-lg shadow-md opacity-0 invisible scale-90 transition-[opacity,visibility,scale] w-full group-data-[accordion=active]/accordion:opacity-100 group-data-[accordion=active]/accordion:visible group-data-[accordion=active]/accordion:scale-100" data-accordion-content>
          <div class="flex flex-col gap-4 p-4">
            {% for item in nav.blocks %}
            <a class="btn btn-gray text-sm underline-offset-4 hover:underline" data-waved="dark" data-scroll-to draggable="false" href="{{ item.href }}">
              {{ item.text }}
            </a>
            {% endfor %}
          </div>
        </div>
      </div>
    </nav>
    <button class="btn btn-second lg:hidden" data-sidebar-open="menu" data-waved="light">
      {{ icon.render(id = 'burger', className = 'icon text-4xl') }}
    </button>
  </header>

  {# Меню #}

  {% set palette = [
    {
      text: 'Первичный',
      name: 'primary',
      value: '#af1a4c'
    },
    {
      text: 'Вторичный',
      name: 'second',
      value: '#d7a751'
    },
    {
      text: 'Черный',
      name: 'black',
      value: '#000000'
    },
    {
      text: 'Белый',
      name: 'white',
      value: '#ffffff'
    },
    {
      text: 'Темно-серый',
      name: 'gray',
      value: '#b2b2b2'
    },
    {
      text: 'Светло-серый',
      name: 'grey',
      value: '#f6f7f9'
    },
    {
      text: 'Темный',
      name: 'dark',
      value: '#303030'
    },
    {
      text: 'Красный',
      name: 'red',
      value: '#be1b1b'
    },
    {
      text: 'Зеленый',
      name: 'green',
      value: '#27ae60'
    }
  ] %}

  <div class="group/menu fixed inset-0 z-40 bg-black/50 transition-[opacity,visibility] duration-100 not-data-open:invisible not-data-open:opacity-0" data-menu data-sidebar="menu" data-breakpoint="lg" data-lenis-prevent>
    <div class="flex flex-col bg-black/70 backdrop-blur-sm overflow-auto transition-[opacity,visibility,transform] duration-300 size-full max-w-93.75 group-not-data-open/menu:invisible group-not-data-open/menu:opacity-0 group-not-data-open/menu:-translate-x-full">
      <div class="flex items-center justify-between gap-2 bg-black transition-transform duration-500 delay-300 p-4 group-not-data-open/menu:-translate-y-full">
        <a class="btn btn-white shrink-0 w-36" data-waved="light" draggable="false" href="/">
          {{ image.render(src = '/img/pictures/logo', format = 'png', className = 'w-full') }}
        </a>
        <input class="switch switch-toggle" data-theme-toggle type="checkbox">
        <button class="btn btn-second p-1" data-sidebar-close="menu" data-waved="light">
          {{ icon.render(id = 'close', className = 'icon text-white text-2xl') }}
        </button>
      </div>
      <nav class="flex flex-col items-start gap-4 text-white transition-[opacity,visibility,transform] duration-700 delay-500 px-4 pt-4 pb-10 group-not-data-open/menu:invisible group-not-data-open/menu:opacity-0 group-not-data-open/menu:-translate-x-full">
        {% for item in nav.pages %}
        <a class="text-xl underline-offset-4 hover:underline" draggable="false" href="{{ item.href }}">
          {{ item.text }}
        </a>
        {% endfor %}
        <div class="group/accordion" data-accordion data-close-click>
          <button class="flex items-center text-xl underline-offset-4 hover:underline" data-accordion-toggle>
            Navigation
            {{ icon.render(id = 'arrow-right', className = 'icon text-sm opacity-60 transition-transform ml-2 group-data-[accordion=active]/accordion:rotate-90') }}
          </button>
          <div data-accordion-content>
            <div class="flex flex-col items-start gap-2 pl-5 pt-2">
              {% for item in nav.blocks %}
              <a class="text-lg underline-offset-4 hover:underline" data-scroll-to data-sidebar-close="menu" draggable="false" href="{{ item.href }}">
                {{ item.text }}
              </a>
              {% endfor %}
            </div>
          </div>
        </div>
      </nav>
      <div class="px-4 pt-4 pb-10 mt-auto transition-[opacity,visibility,transform] duration-500 delay-1000 group-not-data-open/menu:invisible group-not-data-open/menu:opacity-0 group-not-data-open/menu:translate-y-1/4">
        <div class="text-white mb-7" data-palette>
          <ul class="flex flex-col gap-4 mb-8">
            {% for item in palette %}
            <li class="flex items-center justify-between gap-5" data-palette-item>
              <span>
                {{ item.text }}
              </span>
              <input class="bg-transparent cursor-pointer shrink-0 size-7 ml-auto" data-palette-input="{{ item.name }}" type="color" value="{{ item.value }}">
              <button class="btn btn-white text-second rounded" data-palette-button="{{ item.value }}" data-waved="dark">Сбросить</button>
            </li>
            {% endfor %}
          </ul>
          <button class="btn btn-second btn-fill btn-lg w-full" data-palette-reset data-waved="dark">Сбросить всё</button>
        </div>
        <div class="flex items-center justify-center gap-4">
          {% for item in social %}
          <a class="btn btn-second rounded-full" data-waved="dark" draggable="false" href="">
            {{ icon.render(id = item, className = 'icon text-3xl') }}
          </a>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

  {# Перетаскиваемое социальное меню #}

  <nav class="flex flex-col items-center justify-center fixed bottom-2 -left-12 z-20 rounded-full pointer-events-none select-none touch-none size-48" data-social="0.7" data-draggable-parent="draggable">
    <div class="absolute inset-0 bg-primary/30 rounded-full pointer-events-auto transition ease-in-out duration-300 not-data-[social-round=show]:scale-0 not-data-[social-round=show]:-rotate-180 not-data-[social-round=show]:opacity-0" data-social-round>
      {% for item in social %}
      <a class="btn btn-second absolute rounded-full" data-social-link data-waved="dark" draggable="false" href="">
        {{ icon.render(id = item, className = 'icon text-3xl') }}
      </a>
      {% endfor %}
    </div>
    <button class="btn btn-primary btn-contur rounded-full shadow-md pointer-events-auto size-10 p-1 before:content-auto before:block before:bg-current before:rounded-inherit before:size-full" data-social-button data-waved="light" data-draggable="draggable"></button>
  </nav>

  {# Переключатель темы #}

  <div class="hidden lg:flex items-center justify-center fixed bottom-2 left-5 z-20 bg-white dark:bg-black rounded-2xl border border-solid border-gray dark:border-white shadow-md w-max p-4">
    <span class="text-sm mr-2">Темная тема</span>
    <input class="switch switch-toggle" data-theme-toggle type="checkbox">
  </div>

  {# Снежинки #}

  <div class="fixed inset-0 z-40 pointer-events-none" data-snow></div>

  {# Бегующая кнопка #}

  <div class="fixed left-1/2 top-1/2 z-30 transition-[top,left] pointer-coarse:hidden" data-running>
    <button class="btn btn-primary btn-fill btn-lg min-w-max" data-running-button data-waved="light">Поймай меня</button>
  </div>

  {# В покупки #}

  <div class="fixed z-20 top-2/4 left-0 md:left-auto right-0 md:right-10 bg-white dark:bg-black dark:text-white rounded-3xl -translate-y-1/2 shadow-md transition-[opacity,visibility,translate] duration-300 w-full max-w-80 p-5 mx-auto not-data-[shop=show]:invisible not-data-[shop=show]:opacity-0 not-data-[shop=show]:-translate-y-1/3" data-shop>
    <div class="flex items-center justify-between mb-4">
      <h4 class="font-alt font-semibold text-2xl mr-3">
        Product in shop
      </h4>
      <button class="btn btn-primary rounded p-1" data-shop-close data-waved="light">
        {{ icon.render(id = 'close', className = 'icon text-lg') }}
      </button>
    </div>
    <div class="flex items-center mb-4">
      <div class="aspect-square relative bg-grey overflow-hidden rounded shrink-0 w-full max-w-24 mr-5">
        {{ image.render(src = '', className = 'media rounded-inherit', data = 'data-shop-image') }}
      </div>
      <div class="flex flex-col">
        <b class="text-lg md:text-xl mb-3" data-shop-name></b>
        <span class="text-xl md:text-2xl" data-shop-quantity>4 шт</span>
      </div>
    </div>
    <div class="flex items-end justify-between gap-2">
      <div class="flex flex-col">
        <span class="text-xs md:text-base line-through opacity-60" data-shop-oldprice></span>
        <span class="font-semibold text-xl md:text-2xl" data-shop-price></span>
      </div>
      <button class="btn btn-second btn-fade btn-lg px-10" data-waved="dark">Shop</button>
    </div>
  </div>

  {# Умное меню #}

  <nav class="wrapper relative z-10 py-4 {{ '' if data.status else 'hidden' | safe }}">
    <div class="flex items-center justify-between w-full max-w-full" data-smart>
      <h2 class="font-alt font-bold text-lg" data-smart-title>
        Smart-menu items
      </h2>
      <ul class="flex justify-between gap-3" data-smart-length>
        {% for i in range(1, 9) %}
        <li>
          <button class="btn btn-primary btn-text btn-lg dark:bg-dark font-semibold shadow-md min-w-max" data-waved="dark">Smart-menu item
            {{ i }}
          </button>
        </li>
        {% endfor %}
      </ul>
      <div class="relative min-w-max" data-smart-nav data-accordion data-close-scroll>
        <button class="btn btn-primary btn-fill btn-lg btn-bubbles" data-accordion-toggle>
          more <span class="ml-1" data-smart-count></span>
        </button>
        <div class="absolute top-12 right-0 bg-white dark:bg-opacity-0 rounded-lg shadow-md" data-accordion-content>
          <ul class="flex flex-col gap-3 p-3" data-smart-list></ul>
        </div>
      </div>
    </div>
  </nav>

  {# Контент #}

  <main>
    {% block content %}{% endblock %}
  </main>

  {# Карта #}

  <section class="wrapper xl:wrapper-distance relative bg-grey dark:bg-dark overflow-hidden h-96" data-yandex>
    {{ loader.render() }}
    <div class="absolute inset-0" data-yandex-map="45.03191007458623,38.921171499999936"></div>
  </section>

  {# Подвал #}

  <footer class="wrapper flex flex-wrap flex-col md:flex-row items-center justify-between gap-4 bg-black text-second pt-4 pb-10 md:pb-4" id="footer">
    <a class="btn btn-white w-36" data-waved="light" draggable="false" href="/">
      {{ image.render(src = '/img/pictures/logo', format = 'png', className = 'w-full') }}
    </a>
    <address class="text-center">
      ​Рождественская набережная, <br> 45/1​5 офис; 3 этаж
    </address>
    <a class="btn btn-second text-lg w-max p-1" data-waved="light" data-fancybox-dialog data-type="ajax" draggable="false" href="/dialogs/politics.html">Privacy policy</a>
    <div>
      © <span data-annum></span>
    </div>
    <span class="text-lg">
      Разработка: <a class="underline w-max" draggable="false" href="https://stdkit.ru/" target="_blank">Студия К.И.Т.</a>
    </span>
  </footer>

</body>

</html>