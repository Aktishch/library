{% import 'src/components/icon.njk' as icon %}
{% import 'src/components/image.njk' as image %}
{% import 'src/components/loader.njk' as loader %}

{% macro render() %}
<section class="wrapper bg-grey dark:bg-dark" data-player="player" data-random>
  <div id="playlist" style="display: none;">
    <div class="bg-white dark:bg-black text-black dark:text-white rounded-xl w-96 max-w-full p-5 md:p-10">
      <h4 class="font-alt font-bold text-center text-3xl mb-6">
        Playlist
      </h4>
      <ul class="flex flex-col gap-4" data-player-listing></ul>
    </div>
  </div>
  <div class="flex flex-col items-center justify-center bg-white dark:bg-black rounded-3xl shadow-md w-full max-w-lg py-6 px-2 md:px-6 mx-auto transition-[opacity,translate] duration-500 not-data-[anim=show]:opacity-0 not-data-[anim=show]:translate-y-10" data-anim data-player-controls>
    <div class="aspect-square relative bg-grey dark:bg-dark rounded-full overflow-hidden w-full max-w-64 mb-5 md:md-8">
      {{ loader.render() }}
      {{ image.render(src = '', className = 'media rounded-inherit', data = 'data-player-poster') }}
    </div>
    <h3 class="font-alt font-bold text-center text-2xl sm:text-3xl" data-player-artist></h3>
    <h4 class="font-medium text-center text-base sm:text-2xl mb-6" data-player-song></h4>
    <audio hidden data-player-audio></audio>
    <div class="bg-grey dark:bg-dark rounded-2xl w-full py-5 px-3 sm:px-5">
      <div class="relative bg-gray rounded-3xl cursor-pointer w-full h-1 mb-3" data-player-progress>
        <div class="absolute top-0 bottom-0 left-0 bg-primary text-primary rounded-3xl h-full after:cursor-ew-resize after:content-auto after:absolute after:top-0 after:bottom-0 after:-right-1 after:bg-current after:rounded-full after:size-3 after:my-auto" data-player-range></div>
      </div>
      <div class="flex items-center justify-between gap-4">
        <a class="btn btn-primary btn-fade rounded shrink-0 p-1" data-waved="dark" data-fancybox-dialog draggable="false" href="#playlist">
          {{ icon.render(id = 'burger', className = 'icon text-2xl') }}
        </a>
        <span class="hidden md:block text-lg shrink-0 w-12" data-player-start></span>
        <button class="btn btn-primary btn-fade rounded-full shrink-0 size-10" data-player-prev data-waved="dark">
          {{ icon.render(id = 'arrow-prev', className = 'icon text-xl') }}
        </button>
        <button class="btn btn-primary btn-fade text-4xl rounded-full shrink-0 size-10" data-player-play data-waved="dark">
          {{ icon.render(id = 'loading', className = 'loading icon hidden', data = 'data-player-loading') }}
          {{ icon.render(id = 'play', className = 'icon', data = 'data-player-status') }}
        </button>
        <button class="btn btn-primary btn-fade rounded-full shrink-0 size-10" data-player-next data-waved="dark">
          {{ icon.render(id = 'arrow-next', className = 'icon text-xl') }}
        </button>
        <span class="hidden md:block text-lg shrink-0 w-12" data-player-end></span>
        <button class="btn btn-primary btn-fade rounded-full p-2" data-player-volume data-waved="dark">
          {{ icon.render(id = 'volume-on', className = 'icon') }}
        </button>
      </div>
    </div>
  </div>
</section>
{% endmacro %}