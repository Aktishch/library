{% import 'src/components/icon.njk' as icon %}

{% macro render(className = none, data = 'data-loader') %}
<div class="loader {{ (className if className) | safe }}" {{ (data if data) | safe }}>
  <span class="loader-progress">
    {{ icon.render(id = 'loader', className = 'loader-icon icon') }}
  </span>
</div>
{% endmacro %}