{% macro render(src, format = none, className = none, data = none) %}
{% set loading = none %}
{% set source = none %}

{% if format == 'jpg' %}
{% set loading = 'lazy' %}
{% elif format == 'png' %}
{% set loading = 'eager' %}
{% endif %}

{% if src == '#' %}
{% set source = '#' %}
{% elif src != '' %}
{% set source = src ~ '.' ~ format %}
{% endif %}

<img {{ ('class="' ~ className ~ '"' if className) | safe }} {{ (data if data) | safe }} {{ ('loading="' ~ loading ~ '"' if loading) | safe }} {{ ('src="' ~ source ~ '"' if source) | safe }} draggable="false" alt="">
{% endmacro %}