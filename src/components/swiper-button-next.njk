{% from 'src/components/icon.njk' import icon %}

{% macro swiperButtonNext(value) %}
<button class="swiper-button-next btn btn-primary btn-fill hidden md:flex absolute -right-6 rounded-full size-12" data-slider-next="{{ value }}" data-waved>
  {{ icon(id = 'arrow-right', className = 'icon') }}
</button>
{% endmacro %}